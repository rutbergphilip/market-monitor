# Market Monitor Configuration
# Copy this file to .env and update the values

# ============================================================================
# REQUIRED - Generate unique secrets for each!
# ============================================================================
# Generate with: openssl rand -base64 48

JWT_SECRET=
REFRESH_TOKEN_SECRET=
NUXT_SESSION_PASSWORD=

# ============================================================================
# OPTIONAL - Customize as needed
# ============================================================================

# Logging level: debug, info, warn, error
LOG_LEVEL=info

# UI origin for CORS (set to your domain in production)
# Example: https://monitor.yourdomain.com
UI_ORIGIN=http://localhost:3847

# ============================================================================
# PORTS - Customize if defaults conflict with other services
# ============================================================================

# Backend API port (default: 5847)
SERVER_PORT=5847

# Frontend UI port (default: 3847)
UI_PORT=3847
